# Supabase Configuration
# You can find these values in your Supabase Project:
# 1. Go to https://supabase.com/dashboard and select your project.
# 2. In the left sidebar, click Project Settings (gear icon) -> API.
# 3. Under "Project URL", copy the URL value and paste below as NEXT_PUBLIC_SUPABASE_URL.
# 4. Under "Project API keys", copy the 'anon' 'public' key and paste below as NEXT_PUBLIC_SUPABASE_ANON_KEY.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

